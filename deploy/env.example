# gf-eshop 服务器环境变量模板
# ============================================================
# 复制到 /etc/gf-eshop.env 并 chmod 600，然后在里面填**这台服务器**的真实值：
#   sudo cp /opt/gf-eshop/env.example /etc/gf-eshop.env
#   sudo chmod 600 /etc/gf-eshop.env
#   sudo vi /etc/gf-eshop.env
#
# 为什么需要这个文件：发布包里的 manifest/config/config.yaml 是**打包机上的本地文件**
# （含开发库密码、邮箱授权码），而且每次解包都会覆盖服务器上那一份。
# 所以线上真实配置只放这里 —— 解包覆盖 yaml 也不会影响它。
#
# 生效规则
#   - 这里设置了的项 → 覆盖 manifest/config/config.yaml 的同名配置；
#   - **注释掉 = 用 yaml 里的默认值**（不是「关」）；
#   - 设置成空串也算「设置了」（可用来显式清空）。
#
# 命名规则：配置键 → 大写蛇形，"." 与驼峰边界都变成 "_"，大小写不敏感
#   server.address                  → SERVER_ADDRESS
#   database.default.link           → DATABASE_DEFAULT_LINK
#   orderShard.defaultWindowMonths  → ORDER_SHARD_DEFAULT_WINDOW_MONTHS
#   elasticsearch.addresses         → ELASTICSEARCH_ADDRESSES   （逗号分隔）
#
# 语法（systemd EnvironmentFile 与 shell source 都要能读）
#   - KEY=value，**不要写 export**（systemd 不认）；
#   - 注释**必须单独占一行**（systemd 不把行内的 # 当注释，会把注释当成值的一部分）；
#   - 值里不要加引号（除非引号本身是值的一部分）。
# ============================================================

# ---------- 监听地址（必填） ----------
# 反向代理在后端时用 127.0.0.1:8000，对外直连用 :8000
SERVER_ADDRESS=127.0.0.1:8000
# 生产建议关掉请求访问日志（或按需要打开排查）
# SERVER_ACCESS_LOG_ENABLED=false

# ---------- MySQL（必填） ----------
# 整条 DSN 覆盖。注意 ?charset/parseTime/loc 三个参数不能省：
# parseTime=True 决定 datetime 扫成时间而不是字符串，loc 决定分片月份按哪个时区算。
DATABASE_DEFAULT_LINK=mysql:用户名:密码@tcp(127.0.0.1:3306)/eshop_db?charset=utf8mb4&parseTime=True&loc=Local

# ---------- Redis（必填） ----------
REDIS_DEFAULT_ADDRESS=127.0.0.1:6379
# 有密码就填，没有就整行注释掉（空串也等于"有密码但为空"，可能连不上）
# REDIS_DEFAULT_PASS=
# REDIS_DEFAULT_DB=0

# ---------- 安全（必填，务必换成随机串） ----------
# 换了会导致已签发的 token 全部失效
JWT_SECRET=改成随机长串

# ---------- 日志 ----------
# level 常用 all / info / warn / error；stdout=false 时只写文件
LOGGER_LEVEL=info
LOGGER_STDOUT=false

# ---------- Elasticsearch ----------
# 未部署 ES 时设为 false（会回落 MySQL 查询，不影响功能）
ELASTICSEARCH_ENABLED=false
# ELASTICSEARCH_ADDRESSES=http://127.0.0.1:9200
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=

# ---------- 邮件验证码 ----------
# 生产必须 EMAIL_DEV_MODE=false（true 只会把验证码写进日志，不真发信）
EMAIL_ENABLED=true
EMAIL_DEV_MODE=false
EMAIL_SMTP=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=no-reply@example.com
EMAIL_PASS=改成邮箱授权码
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=gf-eshop

# ---------- 短信 ----------
SMS_ENABLED=false
# SMS_SIGN_NAME=
# SMS_TEMPLATE_ID=

# ---------- 订单分表（灰度/切读开关） ----------
# single=读写主表（未分表）；monthly=写分片、读分片（分表终态）
ORDER_SHARD_MODE=monthly
# ORDER_SHARD_DUAL_WRITE=false
# ORDER_SHARD_READ_SHARDS_PERCENT=100
# ORDER_SHARD_SHADOW_READ_PERCENT=0
# 列表不带时间参数时默认回溯的月数（决定要跨几个分片查询）
# ORDER_SHARD_DEFAULT_WINDOW_MONTHS=12

# ---------- 其余可覆盖项（按需打开；注释掉 = 用 yaml 默认值） ----------
# SERVER_LOG_STDOUT=            # 对应配置项 server.logStdout
# JWT_ACCESS_EXPIRE=            # 对应配置项 jwt.access_expire
# JWT_REFRESH_EXPIRE=            # 对应配置项 jwt.refresh_expire
# SMS_DEV_MODE=            # 对应配置项 sms.dev_mode
